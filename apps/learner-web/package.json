{
  "name": "@mediprompt/learner-web",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "pnpm copy:packs",
    "copy:packs": "node scripts/copy-packs.mjs",
    "build": "pnpm copy:packs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@eslint/js": "9.15.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.5"
  }
}
