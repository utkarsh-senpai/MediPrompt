{
  "name": "@mediprompt/learner-web",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.23.2",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "pnpm copy:packs",
    "schema:generate": "node scripts/generate-schema-validator.mjs",
    "schema:check": "node scripts/generate-schema-validator.mjs --check",
    "candidate:generate": "tsx scripts/generate-medical-candidate.ts",
    "candidate:check": "tsx scripts/generate-medical-candidate.ts --check",
    "copy:packs": "node scripts/copy-packs.mjs",
    "build": "pnpm content:validate && pnpm copy:packs && tsc -b && vite build && pnpm build:validate",
    "build:validate": "node scripts/validate-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "test:e2e": "playwright test",
    "content:validate": "pnpm schema:check && pnpm candidate:check && tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "@playwright/test": "1.62.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.6"
  }
}
