{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "noEmit": true,
    // The transcription worker runs in a DedicatedWorkerGlobalScope; DOM types
    // must not leak in (and WebWorker types must not leak into the app program).
    "lib": ["ES2022", "WebWorker"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["../../content/*"]
    }
  },
  "include": [
    "src/speech/transcribe.worker.ts",
    "src/speech/protocol.ts",
    "src/audio/pcmDecode.ts",
    "src/audio/audioErrors.ts",
    "src/practice/types.ts"
  ]
}
