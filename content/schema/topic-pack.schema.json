{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediprompt.app/topic-pack.schema.json",
  "title": "MediPrompt runtime topic pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentKind",
    "packId",
    "version",
    "title",
    "locale",
    "licence",
    "review",
    "sources",
    "subjects"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "contentKind": {
      "type": "string",
      "enum": ["MEDICAL", "NON_MEDICAL_INTERACTION"]
    },
    "packId": { "$ref": "#/$defs/kebabId" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers", "reviewedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["APPROVED", "DRAFT", "NOT_FOR_PUBLICATION"]
        },
        "reviewers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmpty" },
              "role": {
                "type": "string",
                "enum": ["MEDICAL_REVIEWER", "CONTENT_EDITOR"]
              }
            }
          }
        },
        "reviewedAt": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "APPROVED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reviewers": { "type": "array", "minItems": 1 },
              "reviewedAt": { "type": "string" }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "citation", "url", "accessedAt"],
        "properties": {
          "sourceId": { "$ref": "#/$defs/kebabId" },
          "citation": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "accessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "kebabId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "title", "topics"],
      "properties": {
        "subjectId": { "$ref": "#/$defs/kebabId" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "availability": {
          "type": "string",
          "enum": ["ACTIVE", "COMING_SOON"]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/topic" }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "title", "variants", "rubrics", "cases", "followUps"],
      "properties": {
        "topicId": { "$ref": "#/$defs/kebabId" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/variant" }
        },
        "rubrics": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/rubric" } },
        "cases": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/ficCase" } },
        "followUps": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/followUp" }
        },
        "vivaQuestions": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/vivaQuestion" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "challengePreset",
        "difficultyProfileVersion",
        "blueprint",
        "promptId",
        "mode",
        "supportLevel",
        "wording",
        "answerArc",
        "timePolicy",
        "caseRef",
        "followUpRefs",
        "rubricId"
      ],
      "properties": {
        "variantId": { "$ref": "#/$defs/kebabId" },
        "challengePreset": {
          "type": "string",
          "enum": ["GUIDED", "APPLIED", "VIVA"]
        },
        "difficultyProfileVersion": {
          "type": "string",
          "pattern": "^difficulty-profile/1\\.0$"
        },
        "blueprint": { "$ref": "#/$defs/nonEmpty" },
        "promptId": { "$ref": "#/$defs/kebabId" },
        "mode": {
          "type": "string",
          "enum": ["RECALL_SPRINT", "VIVA_ROUND", "DEEP_RESEARCH", "TEACH_BACK"]
        },
        "supportLevel": {
          "type": "string",
          "enum": ["FULL", "FADING", "MINIMAL"]
        },
        "wording": { "type": "string", "minLength": 1, "maxLength": 600 },
        "answerArc": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "timePolicy": { "$ref": "#/$defs/timePolicy" },
        "caseRef": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "followUpRefs": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        },
        "rubricId": { "$ref": "#/$defs/kebabId" }
      }
    },
    "timePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speakingSeconds"],
      "properties": {
        "preparationSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "speakingSeconds": { "type": "integer", "minimum": 15, "maximum": 600 },
        "researchSeconds": { "type": "integer", "minimum": 15, "maximum": 900 }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubricId", "variantId", "register", "concepts"],
      "properties": {
        "rubricId": { "$ref": "#/$defs/kebabId" },
        "variantId": { "$ref": "#/$defs/kebabId" },
        "register": {
          "type": "string",
          "enum": ["EXAMINER", "JUNIOR", "PATIENT"]
        },
        "concepts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conceptId", "label", "acceptedPhrases", "weight", "sourceRefs"],
            "properties": {
              "conceptId": { "$ref": "#/$defs/kebabId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 240 },
              "acceptedPhrases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "weight": { "type": "integer", "minimum": 1, "maximum": 10 },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/kebabId" }
              }
            }
          }
        }
      }
    },
    "ficCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "text"],
      "properties": {
        "caseId": { "$ref": "#/$defs/kebabId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "followUp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["followUpId", "text", "kind"],
      "properties": {
        "followUpId": { "$ref": "#/$defs/kebabId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "kind": {
          "type": "string",
          "enum": ["PROBE", "EVIDENCE_UPDATE"]
        }
      }
    },
    "vivaQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "prompt", "targetConceptIds"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "level": {
          "type": "string",
          "enum": ["RECALL", "EXPLAIN", "APPLY", "DIFFERENTIATE", "DEFEND"]
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 600 },
        "targetConceptIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        }
      }
    }
  }
}
